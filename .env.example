# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change_this_to_a_very_secure_random_string_in_production

# Admin Credentials (CHANGE THIS!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$example_hash_will_be_generated

# hCaptcha Configuration
HCAPTCHA_SECRET=your_hcaptcha_secret_key_here
HCAPTCHA_SITEKEY=your_hcaptcha_site_key_here

# Database
DB_PATH=./server/database/co2m.db

# Session
SESSION_TIMEOUT=3600
