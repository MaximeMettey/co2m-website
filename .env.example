# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change_this_to_a_very_secure_random_string_in_production

# hCaptcha Configuration
HCAPTCHA_SECRET=your_hcaptcha_secret_key_here
HCAPTCHA_SITEKEY=your_hcaptcha_site_key_here

# Database
DB_PATH=./server/database/co2m.db

# Session
SESSION_TIMEOUT=3600

# Note: Admin credentials are stored in the database (server/database/co2m.db)
# Default credentials after running 'npm run init-db':
#   Username: admin
#   Password: Admin@CO2M2024
# Change them via the admin panel: Settings > Security

